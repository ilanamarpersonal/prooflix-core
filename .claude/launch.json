{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prooflix-server",
      "runtimeExecutable": "/Users/ilan.amar/.local/bin/uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "products/ingestiq/server",
        "--extra",
        "spark",
        "prooflix",
        "serve",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "prooflix-postgres",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "run",
        "--rm",
        "--name",
        "prooflix-postgres",
        "-p",
        "127.0.0.1:5432:5432",
        "-e",
        "POSTGRES_USER=prooflix",
        "-e",
        "POSTGRES_PASSWORD=prooflix-dev",
        "-e",
        "POSTGRES_DB=prooflix",
        "-v",
        "prooflix-postgres-data:/var/lib/postgresql/data",
        "postgres:16.4-alpine"
      ],
      "port": 5432
    },
    {
      "name": "prooflix-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "products/ingestiq/client"
      ],
      "port": 5173
    },
    {
      "name": "prooflix-portal-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "products/portal/client"
      ],
      "port": 5174
    },
    {
      "name": "prooflix-insightiq-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "products/insightiq/client"
      ],
      "port": 5175
    },
    {
      "name": "prooflix-settings-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "products/settings/client"
      ],
      "port": 5176
    },
    {
      "name": "prooflix-website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "/Users/ilan.amar/github/prooflix"
      ],
      "port": 8765
    }
  ]
}
