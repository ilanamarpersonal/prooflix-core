# Copy to terraform.tfvars and adjust. Every setting is optional.

# kube_context      = "kind-kind"
# namespace         = "default"
# image_tag         = "dev"
# image_pull_policy = "Never"   # "IfNotPresent" for an image in a registry
# scheduler_enabled = true
# max_depth         = 10
# start_date        = "2026-01-01"  # pipelines with no checkpoint yet start here
# persistence_size  = "10Gi"

# Spark and Unity Catalog (the image has Java, PySpark and the Spark packages):
# spark_driver_memory   = "4g"
# unity_catalog_enabled = true          # run Unity Catalog in the release
# unity_catalog_uri     = ""            # or use one that runs elsewhere
# unity_catalog_catalog = "tenant1"

# Source files on a volume (every workspace's source/ links to /source-data, read-only):
# source_data_volume_enabled = true
# source_data_existing_claim = "my-source-files"

# Data lake on a volume of its own (every workspace's data/ links to /datalake):
# data_lake_volume_enabled = true
# data_lake_volume_size    = "100Gi"
# data_lake_existing_claim = ""   # or bind an existing PVC

# Any other chart value, e.g. an internal Ingress:
# extra_values = {
#   ingress = {
#     enabled   = true
#     className = "nginx"
#     hosts     = [{ host = "prooflix.internal", paths = [{ path = "/", pathType = "Prefix" }] }]
#   }
# }
