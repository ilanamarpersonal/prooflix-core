# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
client/dist/

# workspaces/ holds the workspaces (projects and run history), and catalog/ holds
# imported datasets: user content, not repository code
workspaces/*
!workspaces/.gitkeep
catalog/
server/tests/fixtures/sample_workspace/data/output/

# Terraform: providers and local state (the lock file is committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# OS / editors
.DS_Store
.vscode/
.idea/
